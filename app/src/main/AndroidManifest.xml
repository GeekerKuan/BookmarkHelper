<?xml version="1.0" encoding="utf-8"?><!-- manifest文件详解：http://www.cnblogs.com/pilang/archive/2011/04/20/2022932.html -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- miuix-blur uses RuntimeShader only behind our API 33+ runtime gate. -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <queries>
        <package android:name="mark.via" />
        <package android:name="com.microsoft.emmx" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/xposed_module_description"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".activity.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.TaskActivity"
            android:exported="false" />

        <service
            android:name=".sync.task.SyncTaskForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".activity.TaskCenterActivity"
            android:exported="false" />

        <activity
            android:name=".activity.NewTaskActivity"
            android:exported="false" />

        <activity
            android:name=".activity.DateRangeActivity"
            android:exported="false" />

        <activity
            android:name=".activity.DataBackupRestoreActivity"
            android:exported="false" />

        <activity
            android:name=".activity.PersonalizationActivity"
            android:exported="false" />

        <activity
            android:name=".activity.AppInfoActivity"
            android:exported="false" />

        <activity
            android:name=".activity.ChangelogActivity"
            android:exported="false" />

        <activity
            android:name=".activity.DataManagerActivity"
            android:exported="false" />

        <activity
            android:name=".activity.DeveloperOptionsActivity"
            android:exported="false" />

        <activity
            android:name=".activity.BridgeExperimentActivity"
            android:exported="false" />

        <provider
            android:name=".diagnostics.DiagnosticsFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_file_paths" />
        </provider>
    </application>
</manifest>
